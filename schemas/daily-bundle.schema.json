{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lexaidaily.local/schemas/daily-bundle.schema.json",
  "title": "DailyBundle",
  "description": "LexAIDaily Gate 2 结构化日更数据包（Structured Daily Bundle）正式数据契约 v1.0，作为 Web 预览/详情层、公众号固定栏目与后续 Agent Skill 的唯一共享事实源。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "meta", "items"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "site",
        "column",
        "issue",
        "date",
        "date_line",
        "internal",
        "digest",
        "disclaimer",
        "generated_at"
      ],
      "properties": {
        "site": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "column": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "issue": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "date_line": {
          "type": "string",
          "minLength": 6,
          "maxLength": 80
        },
        "internal": {
          "type": "boolean"
        },
        "internal_note": {
          "type": "string",
          "maxLength": 120
        },
        "digest": {
          "type": "string",
          "minLength": 20,
          "maxLength": 240
        },
        "disclaimer": {
          "type": "string",
          "minLength": 20,
          "maxLength": 300
        },
        "web_detail_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://lexaidaily.local/schemas/candidate-item.schema.json"
      }
    }
  }
}
