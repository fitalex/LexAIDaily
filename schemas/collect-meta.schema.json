{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lexaidaily.local/schemas/collect-meta.schema.json",
  "title": "CollectMeta",
  "description": "LexAIDaily Gate 2 采集运行状态 Meta（cn-meta.json / global-meta.json）正式数据契约 v1.0。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "region",
    "started_at",
    "finished_at",
    "status",
    "sources_attempted",
    "sources_succeeded",
    "sources_failed",
    "items_fetched",
    "items_deduped",
    "cache_ttl_days",
    "cache_pruned_count",
    "source_results"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-_]{3,80}$"
    },
    "region": {
      "type": "string",
      "enum": ["cn", "global"]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["success", "partial", "failed"]
    },
    "sources_attempted": {
      "type": "integer",
      "minimum": 0
    },
    "sources_succeeded": {
      "type": "integer",
      "minimum": 0
    },
    "sources_failed": {
      "type": "integer",
      "minimum": 0
    },
    "items_fetched": {
      "type": "integer",
      "minimum": 0
    },
    "items_deduped": {
      "type": "integer",
      "minimum": 0
    },
    "cache_ttl_days": {
      "type": "integer",
      "const": 7,
      "description": "ADR-0002 锁定的本地私有缓存 7 天 TTL"
    },
    "cache_pruned_count": {
      "type": "integer",
      "minimum": 0
    },
    "source_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "status", "items_count"],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
          },
          "status": {
            "type": "string",
            "enum": ["ok", "error", "skipped", "degraded"]
          },
          "items_count": {
            "type": "integer",
            "minimum": 0
          },
          "http_status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "error_message": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    }
  }
}
