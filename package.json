{
  "name": "lexaidaily-wechat-prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "LexAIDaily 微信公众号每日固定栏目内联排版原型（LD-G1-03）及 Gate 2 数据契约与双轨信源白名单校验。",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:samples": "node scripts/wechat-prototype/build.mjs --in design/wechat/samples/ld-g1-04-2026-11-24.json --out design/wechat/samples/ld-g1-04-2026-11-24.html",
    "test:contracts": "node --test tests/contracts/*.test.mjs",
    "validate:contracts": "node src/contracts/validate.mjs --check-cache",
    "test:sources": "node --test tests/sources/*.test.mjs",
    "smoke:sources": "node scripts/sources/smoke-check.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "js-yaml": "5.5.0",
    "juice": "12.2.6"
  }
}
