{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "LexAIDaily Design Tokens",
  "version": "2.0.0",
  "description": "Design tokens for LexAIDaily Gate 1 Design System v2.0 (Xuan Paper Ink x Liquid Glass Nav). Aligned with Human Decision D-019 and Task Book LD-G1-02B.",
  "color": {
    "background": {
      "canvas": { "value": "#A0BCCE", "type": "color", "description": "Misty slate-blue gradient atmospheric start (per Human 2026-11-11 lighting reference)" },
      "canvasLinen": { "value": "#EAE1D3", "type": "color", "description": "Sunlit warm silk-linen diagonal sweep" },
      "canvasLuminous": { "value": "#F8F4ED", "type": "color", "description": "High-key warm white luminous core highlight" },
      "cardSolid": { "value": "#FFFDF8", "type": "color", "description": "Solid warm white card surface (strictly no glass)" },
      "dateNavPanel": { "value": "#FFFDF8", "type": "color", "description": "Solid warm white compact date navigation panel (per Human 2026-11-11 feedback)" },
      "summaryPanel": { "value": "#FFFDF8", "type": "color", "description": "Right column today summary solid panel" },
      "washShadow": { "value": "#7B98AC", "type": "color", "description": "Diagonal slate-blue shadow wave (opacity 65%)" }
    },
    "glass": {
      "surface": { "value": "rgba(255, 255, 255, 0.60)", "type": "color", "description": "Semi-transparent white liquid glass surface" },
      "sliderSurface": { "value": "#14284B", "type": "color", "description": "Active category navigation slider surface (Deep Navy Accent per Human Feedback)" },
      "sliderText": { "value": "#FFFFFF", "type": "color", "description": "Active category navigation slider text" },
      "borderTop": { "value": "rgba(255, 255, 255, 0.70)", "type": "color", "description": "Liquid glass top highlight border" },
      "borderBottom": { "value": "rgba(220, 212, 192, 0.50)", "type": "color", "description": "Liquid glass bottom subtle edge border" },
      "shadow": { "value": "0 8px 32px rgba(31, 27, 22, 0.08)", "type": "shadow", "description": "Soft warm diffused glass elevation shadow" }
    },
    "reducedTransparency": {
      "glassSurface": { "value": "#F6F1E6", "type": "color", "description": "Solid fallback for category and date navigation bar" },
      "glassSliderSurface": { "value": "#FFFFFF", "type": "color", "description": "Solid fallback for active navigation slider" },
      "glassBorder": { "value": "#DCD4C0", "type": "color", "description": "Solid fallback 1px border" }
    },
    "border": {
      "cardSubtle": { "value": "#E6DFC8", "type": "color", "description": "Warm gray 1px card boundary line" },
      "divider": { "value": "#ECE5D5", "type": "color", "description": "Subtle content divider line" }
    },
    "text": {
      "inkPrimary": { "value": "#1F1B16", "type": "color", "description": "Deep ink black for titles and headings" },
      "inkSecondary": { "value": "#5C5549", "type": "color", "description": "Tier 1 ink gray for summary body text" },
      "inkMuted": { "value": "#8C8373", "type": "color", "description": "Tier 2 ink gray for meta, source line, timestamps" }
    },
    "accent": {
      "navy": { "value": "#14284B", "type": "color", "description": "Single authoritative accent: Deep Navy Blue for headline badge, unverified border, active link detail" },
      "navyHover": { "value": "#0F2347", "type": "color", "description": "Deep navy blue hover state" }
    }
  },
  "typography": {
    "fontFamily": {
      "title": { "value": "'LXGW WenKai TC', 'LXGW WenKai', STKaiti, KaiTi, serif", "type": "fontFamily", "description": "Card titles and article headings" },
      "wordmark": { "value": "'Noto Serif SC', 'Songti SC', SimSun, serif", "type": "fontFamily", "description": "Brand wordmark and site identity" },
      "sans": { "value": "'Noto Sans SC', -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif", "type": "fontFamily", "description": "Summary, meta, navigation, badges, and numbers" }
    },
    "fontSize": {
      "meta": { "value": "12.5px", "type": "dimension" },
      "body": { "value": "15px", "type": "dimension", "description": "Summary text font size (>= 14.5px strict limit)" },
      "titleS": { "value": "18px", "type": "dimension" },
      "titleM": { "value": "21px", "type": "dimension" },
      "titleL": { "value": "30px", "type": "dimension" },
      "wordmark": { "value": "30px", "type": "dimension" },
      "navCategory": { "value": "17px", "type": "dimension" }
    },
    "lineHeight": {
      "meta": { "value": "18px", "type": "dimension" },
      "body": { "value": "26px", "type": "dimension" },
      "titleS": { "value": "26px", "type": "dimension" },
      "titleM": { "value": "30px", "type": "dimension" },
      "titleL": { "value": "38px", "type": "dimension" }
    }
  },
  "layout": {
    "desktop": {
      "canvasWidth": { "value": "1440px", "type": "dimension" },
      "canvasHeight": { "value": "1080px", "type": "dimension" },
      "sidebarWidth": { "value": "240px", "type": "dimension" },
      "summaryWidth": { "value": "300px", "type": "dimension" },
      "gridColumns": { "value": "6", "type": "number" },
      "categoryBarHeight": { "value": "74px", "type": "dimension", "description": "Enlarged floating category capsule height" },
      "categoryBarMinWidth": { "value": "840px", "type": "dimension" }
    },
    "mobile": {
      "canvasWidth": { "value": "390px", "type": "dimension" },
      "canvasHeight": { "value": "960px", "type": "dimension" },
      "dateBarHeight": { "value": "52px", "type": "dimension" },
      "categoryBarHeight": { "value": "56px", "type": "dimension" }
    }
  },
  "component": {
    "card": {
      "borderRadius": { "value": "16px", "type": "dimension" },
      "tierL": {
        "columns": { "value": "4", "type": "number" },
        "titleSize": { "value": "30px", "type": "dimension" },
        "titleLineHeight": { "value": "38px", "type": "dimension" },
        "maxSummaryLines": { "value": "6", "type": "number" }
      },
      "tierM": {
        "columns": { "value": "2", "type": "number" },
        "titleSize": { "value": "21px", "type": "dimension" },
        "titleLineHeight": { "value": "30px", "type": "dimension" },
        "maxSummaryLines": { "value": "4", "type": "number" }
      },
      "tierS": {
        "columns": { "value": "2", "type": "number" },
        "titleSize": { "value": "18px", "type": "dimension" },
        "titleLineHeight": { "value": "26px", "type": "dimension" },
        "maxSummaryLines": { "value": "2", "type": "number" }
      }
    }
  }
}